{
  "name": "tiktok-live-temple-rpc",
  "version": "2.0.0",
  "description": "TikTok Live RPC Interactive Buddhist Temple (Bun.js + ZeroTTS giọng Mai Chi)",
  "main": "server.js",
  "scripts": {
    "start": "bun run server.js",
    "dev": "bun --watch server.js",
    "postinstall": "bun scripts/postinstall.js",
    "setup:venv": "bun scripts/setup-venv.js",
    "build:backend": "bun scripts/build-backend.js",
    "build:sidecars:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-sidecars.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "prayer:dev": "tauri dev",
    "prayer:build": "tauri build",
    "wedding:dev": "bun run --cwd apps/virtual-wedding tauri:dev",
    "wedding:build": "bun run --cwd apps/virtual-wedding tauri:build",
    "studio:start": "bun run apps/live-studio/src/main.js",
    "studio:dev": "bun --watch apps/live-studio/src/main.js",
    "studio:backend": "bun scripts/build-studio-backend.js",
    "studio:tauri:dev": "cd apps/live-studio && tauri dev",
    "studio:build": "cd apps/live-studio && tauri build",
    "build:all": "bun run prayer:build && bun run wedding:build && bun run studio:build",
    "art:devotees": "bun design/art-gen/devotees.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "tiktok-live-connector": "^2.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "playwright-core": "1.56.1"
  }
}
