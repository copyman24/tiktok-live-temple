{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TikTok Live Temple",
  "version": "1.0.0",
  "identifier": "com.linhung.tiktoklivetemple",
  "build": {
    "beforeDevCommand": {
      "script": "bun run build:backend",
      "wait": true
    },
    "beforeBuildCommand": "bun run build:backend",
    "frontendDist": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TikTok Live Temple",
        "url": "http://localhost:3000",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/temple-backend"],
    "resources": {
      "../public/": "public/"
    }
  }
}
