{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virtual Wedding Live",
  "version": "1.0.0",
  "identifier": "com.linhung.virtualweddinglive",
  "build": {
    "beforeDevCommand": "bun run build:backend",
    "beforeBuildCommand": "bun run build:backend",
    "frontendDist": "http://127.0.0.1:3108"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Virtual Wedding Live",
        "url": "http://127.0.0.1:3108",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:3108 ws://127.0.0.1:3108; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/wedding-backend"],
    "resources": {
      "../web/": "web/"
    }
  }
}
